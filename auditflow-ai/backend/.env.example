# AuditFlow AI - Reconcile. Investigate. Resolve.
DATABASE_URL=sqlite:///./auditflow.db

# Optional local LLM. Leave OLLAMA_MODEL empty to auto-use the first installed model.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

HIGH_VALUE_THRESHOLD=100000
STRICT_DATE_TOLERANCE_DAYS=1
RELAXED_DATE_TOLERANCE_DAYS=3

MATCH_THRESHOLD=90
LIKELY_MATCH_THRESHOLD=75
REVIEW_THRESHOLD=50

AMOUNT_SCORE_WEIGHT=40
DATE_SCORE_WEIGHT=20
DESCRIPTION_SCORE_WEIGHT=20
REFERENCE_SCORE_WEIGHT=20

# Optional extras: MAX_UPLOAD_MB=20  CORS_ORIGINS=http://localhost:3000  LOG_LEVEL=INFO  LLM_MAX_EXPLANATIONS=25
